STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# PayTR (Magaza Paneli > Bilgi). Leave empty to disable the PayTR provider.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Public storefront URL; PayTR returns the shopper to <url>/api/paytr-return
PAYTR_STOREFRONT_URL=http://localhost:8000
# Test mode is ON unless set to "false". Set to false only in production.
PAYTR_TEST_MODE=true
PAYTR_DEBUG=false
# 0 = PayTR maximum, otherwise 2-12
PAYTR_MAX_INSTALLMENT=0
PAYTR_NO_INSTALLMENT=false
