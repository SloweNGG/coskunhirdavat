STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# PayTR (Magaza Paneli > Bilgi). Leave empty to disable the PayTR provider.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Public storefront URL; PayTR returns the shopper to <url>/api/paytr-return
PAYTR_STOREFRONT_URL=http://localhost:8000
# Test mode is ON unless set to "false". Set to false only in production.
PAYTR_TEST_MODE=true
PAYTR_DEBUG=false
# 0 = PayTR maximum, otherwise 2-12
PAYTR_MAX_INSTALLMENT=0
PAYTR_NO_INSTALLMENT=false

# Email (Resend). Leave RESEND_API_KEY empty to log emails to the console instead.
RESEND_API_KEY=
# Sender, must be on a domain verified in Resend, e.g. "Coşkun Hırdavat <siparis@coskunhirdavat.com>"
RESEND_FROM=
# Public storefront URL used in email links (falls back to PAYTR_STOREFRONT_URL)
# and in Google Merchant feed links at /product-feed (default http://localhost:8001)
STOREFRONT_URL=

# Sentry error tracking + tracing. Leave SENTRY_DSN empty to disable completely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Fraction of requests traced (0-1). Errors are always reported.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SERVICE_NAME=coskunhirdavat-backend

# Public URL of this backend (used for locally uploaded file links)
BACKEND_URL=http://localhost:9001
